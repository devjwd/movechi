# MOVECHI Frontend Environment Variables
# Copy this to .env.local for local development
# On Vercel: Set these in Dashboard → Settings → Environment Variables

# ========================================
# SMART CONTRACT CONFIGURATION
# ========================================

# The deployed Movechi game contract address on Movement testnet
# This is where the game logic lives (spins, staking, rewards)
VITE_CONTRACT_ADDRESS=0xa00435865d8a71fc68e7dc7724f2f37c6ec1848161ad1e086583b02bf0be5574

# The Move module name inside the contract (must match Move.toml)
VITE_MODULE_NAME=main

# The NFT collection address for Movechi NFTs
# Players stake these NFTs to earn free spins
VITE_COLLECTION_ID=0x202756596fae8e6a97ff20930eb4bfd2658ce0ae926bc6f53a298279a9d3f875

# ========================================
# MOVEMENT NETWORK RPC & SERVICES
# ========================================

# RPC endpoint to communicate with Movement testnet blockchain
# Used for: wallet connections, submitting transactions, querying contract state
VITE_FULLNODE_URL=https://testnet.movementnetwork.xyz/v1

# Faucet to get free test MOVE tokens (for testing paid spins)
# Players click this link to get testnet tokens for free
VITE_FAUCET_URL=https://faucet.testnet.movementnetwork.xyz/

# Block explorer to view transactions
# Players can view their transaction history and contract interactions
VITE_EXPLORER_URL=https://explorer.movementnetwork.xyz/?network=bardock+testnet

# ========================================
# NOTES
# ========================================
# - All VITE_ prefixed variables are embedded at build time by Vite
# - These values are NOT secret - they're public on the blockchain
# - No private keys or sensitive data should be stored here
